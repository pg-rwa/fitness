PORT=3000
JWT_SECRET=change-me-to-a-secure-random-string
JWT_EXPIRES_IN=7d

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# File storage (local or s3)
STORAGE_TYPE=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=uploads

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=FitTracker <noreply@fittracker.app>

# AI Insights (Anthropic Claude API)
ANTHROPIC_API_KEY=

# Admin panel
ADMIN_PORT=3001
