PORT=3000
JWT_SECRET=change-me-to-a-secure-random-string
JWT_EXPIRES_IN=7d

# Database — PostgreSQL (recommended for production)
# Set DATABASE_URL to use PostgreSQL; omit to use SQLite (default for dev)
# DATABASE_URL=postgres://fitness:fitness_secret@localhost:5432/fitness
POSTGRES_PASSWORD=fitness_secret

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# File storage (local or s3)
STORAGE_TYPE=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=uploads

# Email — Option 1: Resend (recommended, https://resend.com)
RESEND_API_KEY=
# Email — Option 2: SMTP (fallback if no RESEND_API_KEY)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender address (must match verified domain in Resend/SMTP)
EMAIL_FROM=FitTracker <noreply@fittracker.app>

# AI Insights (Anthropic Claude API)
ANTHROPIC_API_KEY=

# Admin panel
ADMIN_PORT=3001
